#!/bin/sh
# Sourced by bin/firefly before every command (start, eval, rpc, remote...).
# See "Running several nodes" in README.md.

# The node's name. Clustered (FIREFLY_CLUSTER=postgres) or given a host, a
# long name other nodes can reach: firefly@FIREFLY_NODE_HOST (e.g. the pod
# IP), else firefly@<this machine's first address>. Otherwise the default
# short name (firefly@<hostname>), reachable from this machine only.
# RELEASE_DISTRIBUTION and RELEASE_NODE, when set, win.
if [ "${FIREFLY_CLUSTER:-}" = "postgres" ] || [ -n "${FIREFLY_NODE_HOST:-}" ]; then
  node_host="${FIREFLY_NODE_HOST:-$(hostname -i 2>/dev/null | cut -d' ' -f1)}"
  export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
  export RELEASE_NODE="${RELEASE_NODE:-<%= @release.name %>@${node_host:-127.0.0.1}}"
fi

# The node itself listens for distribution on one fixed port
# (FIREFLY_DIST_PORT, default 9100) besides EPMD's 4369, so firewalls and
# network policies can allow just those. Remote consoles and rpc calls
# connect out only, and eval doesn't start distribution.
case $RELEASE_COMMAND in
  start* | daemon*)
    dist_port="${FIREFLY_DIST_PORT:-9100}"
    export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -kernel inet_dist_listen_min $dist_port inet_dist_listen_max $dist_port"
    ;;
esac
