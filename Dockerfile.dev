# Development image (used by docker-compose.yml). For the production image,
# see Dockerfile.
FROM hexpm/elixir:1.20.5-erlang-29.1.2-debian-trixie-20261027-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    VIX_COMPILATION_MODE=PLATFORM_PROVIDED_LIBVIPS

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends build-essential git ca-certificates curl nodejs npm inotify-tools \
      pkg-config libvips-dev && \
    rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force && mix local.rebar --force

WORKDIR /firestorm
COPY mix.exs mix.lock ./
COPY apps/firefly/mix.exs apps/firefly/
COPY apps/firefly_plugins/mix.exs apps/firefly_plugins/
COPY apps/firefly_web/mix.exs apps/firefly_web/
RUN mix deps.get

COPY apps/firefly_web/assets/package.json apps/firefly_web/assets/package-lock.json ./apps/firefly_web/assets/
RUN npm ci --prefix apps/firefly_web/assets

COPY . .
