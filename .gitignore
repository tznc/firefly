# The directory Mix will write compiled artifacts to.
/_build

# If you run "mix test --cover", coverage assets end up here.
/cover

# The directory Mix downloads your dependencies sources to.
/deps

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Uploads stored on local disk in development (FIREFLY_UPLOAD_DIR, relative
# to the app started: the root or apps/firefly_web).
/uploads/
/apps/*/uploads/

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

/**/node_modules/*
node_modules/*
design/**/_build/*
screenshots

# Generated assets (built by `mix assets.build` / `mix assets.deploy`)
/apps/*/priv/static/assets/
/apps/*/priv/static/cache_manifest.json
/apps/*/priv/static/**/*-????????????????????????????????.*
/apps/*/priv/static/**/*.gz
/priv/plts/

# ExUnit @tag :tmp_dir scratch files.
/tmp/
/apps/*/tmp/

# Sobelow's link to config/ (see "Security checks" in README.md).
/apps/firefly_web/config
